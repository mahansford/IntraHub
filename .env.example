# Copy this file to .env and fill in real values before running docker compose up.

# Your Postgres server
DB_HOST=10.11.10.10
DB_PORT=5432
DB_NAME=intrahub
DB_USER=intrahub
DB_PASSWORD=changeme

# Optional: PIN to protect the ⚙️ Customize / edit mode. Leave blank for no
# protection at all (anyone on the network can add/remove/reorder sections).
ADMIN_PIN=

# Optional: link shown in the footer to this project's source (AGPL-3.0
# requires that users of a modified, network-deployed copy can get the
# source — point this at your fork if you change the code).
SOURCE_URL=https://github.com/mahansford/IntraHub

# Note: dashboard title and weather location are no longer set via env vars
# — configure them from config/local.yml on first boot, or live via the
# ⚙️ Customize button afterwards.
